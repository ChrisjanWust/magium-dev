choice("Invest points later(by pressing the stats button on the top of the screen)", B2-Ch04a-Private, v_current_scene = B2-Ch04a-Private)


ID: B2-Ch04a-Stats-spent
TEXT:

#if(v_ch11_saved_rose == 1) {
