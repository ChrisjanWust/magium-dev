ID: B3-Ch09c-Between
TEXT:

set(v_ac_b3_ch9_consolation,+1) if (v_b3_ch9_currents == 0 && v_is_dead == 0 && v_reflexes < 2 || v_b3_ch9_currents == 1 && v_is_dead == 0 && v_reflexes < 4)
